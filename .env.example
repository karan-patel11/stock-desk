# Copy to .env (never commit .env).

# Absolute path to this repo. Optional: if empty, tools use the repo they live in.
STOCKDESK_HOME=

# SEC fair-access policy: a descriptive app name plus a REAL contact email.
# Example shape: StockDesk Jane Doe jane@university.edu
# Tools refuse to call SEC while this still holds the placeholder below.
SEC_USER_AGENT="StockDesk your-name your-email@example.com"

# How long news (GDELT) responses stay cached, in seconds. Empty means 3600.
# STOCKDESK_CACHE_TTL does not apply to news. Demo day: set 86400, then warm the cache by running the
# sentiment agent's exact news.py query once (see README, Demo day). The cache only matches that exact query.
STOCKDESK_NEWS_CACHE_TTL=
