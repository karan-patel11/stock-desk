# Copy to .env (never commit .env).

# Absolute path to this repo. Optional: if empty, tools use the repo they live in.
STOCKDESK_HOME=

# SEC fair-access policy: a descriptive app name plus a REAL contact email.
# Example shape: StockDesk Jane Doe jane@university.edu
# Tools refuse to call SEC while this still holds the placeholder below.
SEC_USER_AGENT="StockDesk your-name your-email@example.com"
