# Stock Desk configuration: ~/.stockdesk/config.env (or <STOCKDESK_HOME>/config.env).
# `stockdesk init` writes this file for you (mode 0600). Environment variables override it.
# Simple KEY=VALUE lines; # starts a comment. Never commit a filled-in copy.

# SEC fair-access policy: an app name plus a REAL contact email. Tools refuse to call SEC without it.
# Shape: StockDesk you@your-domain.edu
SEC_USER_AGENT=

# Optional. Absolute path of the data home (evidence/, cache/, config/). Only meaningful in ~/.stockdesk/config.env:
# it moves the home elsewhere. Empty means ~/.stockdesk. The STOCKDESK_HOME environment variable wins over this.
# STOCKDESK_HOME=

# Optional tuning, all may be left unset.
# How long news (GDELT) responses stay cached, in seconds (default 3600). STOCKDESK_CACHE_TTL does not apply to news.
# STOCKDESK_NEWS_CACHE_TTL=
# The same in hours (news only; STOCKDESK_NEWS_CACHE_TTL wins if both are set). Demo day: 24.
# STOCKDESK_CACHE_TTL_HOURS=
# fund drops a metric whose latest quarterly value ended more than this many days ago (default 200).
# STOCKDESK_MAX_FUND_AGE_DAYS=

# Narrator (scripts/narrator.py, optional): a read-only Slack bot token (xoxb-..., channels:history) and channel ID.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
